---
import Base from "../layouts/Base.astro";

const posts = [
  { id: "bridging-object-oriented-and-functional-thinking-in-modern-cpp", title: "Bridging Object-Oriented and Functional Thinking in Modern C++", desc: "Why functional thinking matters for C++ developers coming from OOP" },
  { id: "handling-side-effects-in-modern-cpp-designing-systems-around-pure-functions", title: "Handling Side Effects in Modern C++: Interfacing Pure Functions with Our Imperative World", desc: "Using the functional core–imperative shell pattern to mitigate dependencies" },
  { id: "when-one-shell-isnt-enough-scaling-the-functional-core-imperative-shell-pattern-with-actors-in-cpp", title: "When One Shell Isn't Enough: Scaling the Functional Core–Imperative Shell Pattern with Actors in C++", desc: "How to structure growing C++ systems into actor-driven core–shell pairs that isolate dependencies" },
  { id: "mastering-state-in-modern-cpp-making-it-explicit", title: "Mastering State in Modern C++: Making It Explicit", desc: "Passing state as data in the functional core–imperative shell" },
  { id: "mastering-state-in-modern-cpp-making-it-encapsulated", title: "Mastering State in Modern C++: Making It Encapsulated", desc: "Explicit state with encapsulated meaning" },
  { id: "mastering-state-in-modern-cpp-making-it-protected", title: "Mastering State in Modern C++: Making It Protected", desc: "Explicit state with protected evolution" },
];
---

<Base title="FunkyPosts">
  <article class="index-layout">
    <header>
      <img src="/banner.png" alt="FunkyPosts" class="banner" />
      <p><strong>Bridging object-oriented and functional thinking in C++</strong></p>
      <p><small>Applying functional thinking to solve real-world C++ design problems—practical, experience-driven, beyond theory.</small></p>
    </header>
    <ul role="list">
      {posts.map((post) => (
        <li>
          <span class="post-title"><a href={`/posts/${post.id}/`} set:html={post.title.replace(": ", ":<br />")} /></span>
          <span class="post-desc">{post.desc}</span>
        </li>
      ))}
    </ul>
    <footer>
      <small>Posts are created with AI assistance for brainstorming and improving formulation.</small><br />
      <small>Copyright © 2026 mahush. All rights reserved. No license granted.</small>
    </footer>
  </article>
</Base>

<style>
  .index-layout {
    max-width: 52rem;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  header {
    text-align: center;
  }

  .banner {
    width: 100%;
    height: auto;
    border-radius: 8px;
    margin-bottom: 1rem;
  }

  footer {
    text-align: center;
  }

  ul {
    padding-left: 0;
    margin: 0;
  }

  ul li {
    list-style: none;
  }

  li {
    margin-bottom: 1.5rem;
  }

  .post-title {
    display: block;
  }

  .post-desc {
    display: block;
    color: #666;
  }
</style>
